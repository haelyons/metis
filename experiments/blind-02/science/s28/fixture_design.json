  "evaluator": {
    "what": "The published DockQ implementation of PINDER (pinder_eval, BiotiteDockQ) at the pinned source, scoring each assembled model of one invocation against the input's native complex with the model's chains R and L mapped to the native's receptor and ligand chains.",
    "spec": {
      "program": "pinder (pinder.eval.dockq, BiotiteDockQ)",
      "repository": "https://github.com/pinder-org/pinder",
      "commit": "ebeb28a2f8411363cef722b7d293c978f7442672",
      "archive_url": "https://codeload.github.com/pinder-org/pinder/tar.gz/ebeb28a2f8411363cef722b7d293c978f7442672",
      "archive_sha256": "b577532820ebbe5c16432b78c5e9c197690e863cb70a0a35a8ebcbe5277b76dd",
      "private_data": "for each input, the native complex named in spec.reference, fetched by fetch_private.sh from its URL and checked against its SHA-256 and byte count",
      "reads": "the model_<rank>.pdb files under CMP_ARM_OUT, in rank order",
      "invocation": "BiotiteDockQ is constructed with parallel_io=False (models read in the evaluator's own process). The evaluator's Python code is a regular file kept in the harness and run by evaluate.sh as the venv interpreter followed by that file's path, never as a program read from standard input: PINDER's parallel reader starts its workers with the spawn method, which re-imports the main program from its file.",
      "writes": "CMP_EVAL_OUT/dockq.json, one JSON array of the DockQ values in rank order and no other number; any per-model detail goes to a separate file under CMP_EVAL_OUT"
    },
    "timeout_s": 180
  },
