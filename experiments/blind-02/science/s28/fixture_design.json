  "outputs": [
    {
      "name": "transforms",
      "what": "The rotation and translation fields of every ranked prediction row of the arm's docking.out (all fields of the row except the last), in file order.",
      "format": "text_numbers",
      "select": "^[ \\t]*([-+0-9.eE]+[ \\t]+[-+0-9.eE]+[ \\t]+[-+0-9.eE]+[ \\t]+[-+0-9.eE]+[ \\t]+[-+0-9.eE]+[ \\t]+[-+0-9.eE]+)[ \\t]+[-+0-9.eE]+[ \\t]*$"
    },
    {
      "name": "scores",
      "what": "The score field (the last field) of every ranked prediction row of the arm's docking.out, in file order.",
      "format": "text_numbers",
      "select": "^[ \\t]*[-+0-9.eE]+[ \\t]+[-+0-9.eE]+[ \\t]+[-+0-9.eE]+[ \\t]+[-+0-9.eE]+[ \\t]+[-+0-9.eE]+[ \\t]+[-+0-9.eE]+[ \\t]+([-+0-9.eE]+)[ \\t]*$"
    },
    {
      "name": "coords",
      "what": "The x, y and z coordinate columns of every ATOM and HETATM record of the arm's assembled models, models taken in rank order.",
      "format": "text_numbers",
      "select": "^(?:ATOM  |HETATM).{24}(.{24})"
    },
    {
      "name": "dockq",
      "what": "The evaluator's DockQ value for each of the arm's assembled models, as one JSON array in rank order, in a file that holds no other number.",
      "format": "json_numbers",
      "select": null
    }
  ],
