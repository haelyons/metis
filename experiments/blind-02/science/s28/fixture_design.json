{
  "arms": [
    {
      "id": "A0",
      "what": "Seed configuration 1: the published MEGADOCK CPU build with standard rotational sampling and the shared scoring settings, followed by reconstruction of every ranked model with the published decoygen and assembly of each model as receptor records, then ligand records, then one END line.",
      "commands": [
        ["baseline-published/megadock/megadock", "-R", "{spec:/prepared/receptor}", "-L", "{spec:/prepared/ligand}", "-o", "{out}/docking.out", "-N", "50", "-t", "1", "-v", "1.2", "-e", "1.0", "-d", "1.0", "-a", "-45.0", "-b", "1.0", "-f", "3", "-r", "3600"],
        ["bash", "-c", "set -euo pipefail; for r in $(seq 1 50); do baseline-published/megadock/decoygen \"lig_$r.pdb\" \"$2\" \"$0/docking.out\" \"$r\" > \"decoygen_$r.log\" 2>&1; grep -v '^END' \"$1\" > \"$0/model_$r.pdb\"; grep -v -E '^(END|ENDMDL)' \"lig_$r.pdb\" >> \"$0/model_$r.pdb\"; echo END >> \"$0/model_$r.pdb\"; done", "{out}", "{spec:/prepared/receptor}", "{spec:/prepared/ligand}"]
      ],
      "env": {"OMP_NUM_THREADS": "26", "OMP_DYNAMIC": "FALSE", "OPENBLAS_NUM_THREADS": "1", "MKL_NUM_THREADS": "1", "NUMEXPR_NUM_THREADS": "1", "LC_ALL": "C", "LANG": "C", "CUDA_VISIBLE_DEVICES": "0"}
    },
