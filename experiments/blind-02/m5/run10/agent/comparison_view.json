  "outputs": [
    {
      "name": "transforms",
      "what": "The rotation and translation fields of every ranked prediction row of the arm's docking.out (all fields of the row except the last), in file order.",
      "format": "text_numbers",
      "select": "^[ \\t]*([-+0-9.eE]+[ \\t]+[-+0-9.eE]+[ \\t]+[-+0-9.eE]+[ \\t]+[-+0-9.eE]+[ \\t]+[-+0-9.eE]+[ \\t]+[-+0-9.eE]+)[ \\t]+[-+0-9.eE]+[ \\t]*$"
    },
    {
      "name": "scores",
      "what": "The score field (the last field) of every ranked prediction row of the arm's docking.out, in file order.",
      "format": "text_numbers",
      "select": "^[ \\t]*[-+0-9.eE]+[ \\t]+[-+0-9.eE]+[ \\t]+[-+0-9.eE]+[ \\t]+[-+0-9.eE]+[ \\t]+[-+0-9.eE]+[ \\t]+[-+0-9.eE]+[ \\t]+([-+0-9.eE]+)[ \\t]*$"
    },
    {
      "name": "coords",
      "what": "The x, y and z coordinate columns of every ATOM and HETATM record of the arm's assembled models, models taken in rank order.",
      "format": "text_numbers",
      "select": "^(?:ATOM  |HETATM).{24}(.{24})"
    },
    {
      "name": "dockq",
      "what": "The evaluator's DockQ value for each of the arm's assembled models, as one JSON array in rank order, in a file that holds no other number.",
      "format": "json_numbers",
      "select": null
    }
  ],
  "metrics": [
    {
      "name": "wall",
      "unit": "s",
      "what": "Trusted wall of the invocation: adapter and arm commands, plus the evaluator part.",
      "source": "trusted_wall",
      "reduce": null,
      "expect_count": null
    },
    {
      "name": "dockq_rank1",
      "unit": "DockQ",
      "what": "The evaluator's DockQ value of the arm's top-ranked model for the input: the first value of the evaluator's DockQ array.",
      "source": "sealed_extraction",
      "reduce": "first",
      "expect_count": 50
    },
    {
      "name": "dockq_best50",
      "unit": "DockQ",
      "what": "The largest of the evaluator's DockQ values over all of the arm's retained models for the input.",
      "source": "sealed_extraction",
      "reduce": "max",
      "expect_count": 50
    }
  ],
  "evaluator": {
    "what": "The published DockQ implementation of PINDER (pinder_eval, BiotiteDockQ) at the pinned source, scoring each assembled model of one invocation against the input's native complex with the model's chains R and L mapped to the native's receptor and ligand chains.",
    "spec": {
      "program": "pinder (pinder.eval.dockq, BiotiteDockQ)",
      "repository": "https://github.com/pinder-org/pinder",
      "commit": "ebeb28a2f8411363cef722b7d293c978f7442672",
      "archive_url": "https://codeload.github.com/pinder-org/pinder/tar.gz/ebeb28a2f8411363cef722b7d293c978f7442672",
      "archive_sha256": "b577532820ebbe5c16432b78c5e9c197690e863cb70a0a35a8ebcbe5277b76dd",
      "private_data": "for each input, the native complex named in spec.reference, fetched by fetch_private.sh from its URL and checked against its SHA-256 (the concatenation of the pieces in spec.reference.sha256) and byte count. fetch_private.sh is self-contained: it carries each input's reference name, URL, byte count and SHA-256 in its own text and reads no other file under harness/, because only the sealed comparison files and the usual harness scripts are uploaded to the box.",
      "reads": "the model_<rank>.pdb files under CMP_ARM_OUT, in rank order; the native complex under CMP_PRIVATE at the name, byte count and SHA-256 (the concatenation of the pieces) given by spec.reference in CMP_INPUT_SPEC",
      "invocation": "BiotiteDockQ is constructed with parallel_io=False (models read in the evaluator's own process). evaluate.sh is self-contained: it carries the evaluator's Python program in its own text, writes it at each call to a regular file under CMP_EVAL_OUT, and runs it as the venv interpreter followed by that file's path. It never runs a program read from standard input (PINDER's parallel reader starts its workers with the spawn method, which re-imports the main program from its file) and never runs or reads any other file under harness/, which is not uploaded to the box.",
      "writes": "CMP_EVAL_OUT/dockq.json, one JSON array of the DockQ values in rank order and no other number; any per-model detail goes to a separate file under CMP_EVAL_OUT"
    }
  },
  "replicates": 7,
  "warmup": 1
}
