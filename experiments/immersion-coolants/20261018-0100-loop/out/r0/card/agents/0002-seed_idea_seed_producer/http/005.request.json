, budget_usd, fs_usd_gib_month (the price sheet's filesystem price per GiB-month), + - * / ^ ( ), ceil floor min max pow.\\\"},\\\"need\\\":{\\\"anyOf\\\":[{\\\"type\\\":\\\"string\\\"},{\\\"type\\\":\\\"number\\\"}],\\\"description\\\":\\\"The estimated work in hours when hours is a time box. An expression: numbers, ids of numbers, rates and lines, budget_usd, fs_usd_gib_month (the price sheet's filesystem price per GiB-month), + - * / ^ ( ), ceil floor min max pow.\\\"},\\\"usd\\\":{\\\"anyOf\\\":[{\\\"type\\\":\\\"string\\\"},{\\\"type\\\":\\\"number\\\"}],\\\"description\\\":\\\"Dollars (storage, or an allotment given in dollars). An expression: numbers, ids of numbers, rates and lines, budget_usd, fs_usd_gib_month (the price sheet's filesystem price per GiB-month), + - * / ^ ( ), ceil floor min max pow.\\\"},\\\"optional\\\":{\\\"type\\\":\\\"boolean\\\"},\\\"instead_of\\\":{\\\"type\\\":\\\"array\\\",\\\"items\\\":{\\\"type\\\":\\\"string\\\"},\\\"description\\\":\\\"Line ids this line is an alternative to.\\\"},\\\"condition\\\":{\\\"type\\\":\\\"string\\\",\\\"description\\\":\\\"When this line runs.\\\"}},\\\"required\\\":[\\\"id\\\",\\\"phase\\\",\\\"what\\\",\\\"kind\\\"]}},\\\"scenarios\\\":{\\\"type\\\":\\\"array\\\",\\\"items\\\":{\\\"type\\\":\\\"object\\\",\\\"properties\\\":{\\\"id\\\":{\\\"type\\\":\\\"string\\\"},\\\"what\\\":{\\\"type\\\":\\\"string\\\"},\\\"set\\\":{\\\"type\\\":\\\"object\\\",\\\"additionalProperties\\\":{\\\"type\\\":\\\"number\\\"},\\\"description\\\":\\\"Number id to the value it takes in this scenario.\\\"}},\\\"required\\\":[\\\"id\\\",\\\"what\\\",\\\"set\\\"]}},\\\"yields\\\":{\\\"type\\\":\\\"array\\\",\\\"items\\\":{\\\"type\\\":\\\"string\\\"},\\\"description\\\":\\\"Ids of numbers that say what the money buys.\\\"},\\\"spend_cap_usd\\\":{\\\"type\\\":\\\"number\\\",\\\"description\\\":\\\"Your hard stop in dollars.\\\"},\\\"total_stated\\\":{\\\"type\\\":\\\"number\\\",\\\"description\\\":\\\"Your own total in dollar