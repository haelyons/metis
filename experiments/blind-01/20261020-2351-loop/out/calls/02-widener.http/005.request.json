\"source_urls\\\":{\\\"type\\\":\\\"array\\\",\\\"items\\\":{\\\"type\\\":\\\"string\\\"},\\\"description\\\":\\\"At most 3.\\\"},\\\"narrowing\\\":{\\\"type\\\":\\\"string\\\",\\\"description\\\":\\\"Optional, asked for by the idea loop when the root question is not compute-bound: what of the root question this option leaves aside, what the computed observable stands in for, and why its answer still moves the root question.\\\"}},\\\"required\\\":[\\\"id\\\",\\\"title\\\",\\\"summary\\\",\\\"root_link\\\",\\\"compute_open\\\",\\\"sequential\\\",\\\"source_urls\\\"]}}},\\\"required\\\":[\\\"items\\\"]}\""
