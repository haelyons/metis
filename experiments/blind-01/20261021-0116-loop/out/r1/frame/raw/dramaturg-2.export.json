,\"logprobs\":null,\"delta\":{\"tool_calls\":[{\"index\":1,\"function\":{\"arguments\":\": \"}}]}}],\"usage\":null}\n+\n+data: {\"id\":\"chatcmpl-8e69ad2908d544f3b9c25dd7ed67ce6c\",\"object\":\"chat.completion.chunk\",\"created\":1792556096,\"model\":\"deepseek-v4.1-flash\",\"choices\":[{\"index\":0,\"finish_reason\":null,\"logprobs\":null,\"delta\":{\"tool_calls\":[{\"index\":1,\"function\":{\"arguments\":\"\\\"\"}}]}}],\"usage\":null}\n+\n+data: {\"id\":\"chatcmpl-8e69ad2908d544f3b9c25dd7ed67ce6c\",\"object\":\"chat.completion.chunk\",\"created\":1792556096,\"model\":\"deepseek-v4.1-flash\",\"choices\":[{\"index\":0,\"finish_reason\":null,\"logprobs\":null,\"delta\":{\"tool_calls\":[{\"index\":1,\"function\":{\"arguments\":\"text\"}}]}}],\"usage\":null}\n+\n+data: {\"id\":\"chatcmpl-8e69ad2908d544f3b9c25dd7ed67ce6c\",\"object\":\"chat.completion.chunk\",\"created\":1792556096,\"model\":\"deepseek-v4.1-flash\",\"choices\":[{\"index\":0,\"finish_reason\":null,\"logprobs\":null,\"delta\":{\"tool_calls\":[{\"index\":1,\"function\":{\"arguments\":\"\\\"\"}}]}}],\"usage\":null}\n+\n+data: {\"id\":\"chatcmpl-8e69ad2908d544f3b9c25dd7ed67ce6c\",\"object\":\"chat.completion.chunk\",\"created\":1792556096,\"model\":\"deepseek-v4.1-flash\",\"choices\":[{\"index\":0,\"finish_reason\":null,\"logprobs\":null,\"delta\":{\"tool_calls\":[{\"index\":1,\"function\":{\"arguments\":\"}\"}}]}}],\"usage\":null}\n+\n+data: {\"id\":\"chatcmpl-8e69ad2908d544f3b9c25dd7ed67ce6c\",\"object\":\"chat.completion.chunk\",\"created\":1792556096,\"model\":\"deepseek-v4.1-flash\",\"choices\":[{\"index\":0,\"finish_reason\":\"tool_calls\",\"logprobs\":null,\"delta\":{\"content\":\"\",\"reasoning_content\":null}}],\"usage\":{\"prompt_tokens\":4236,\"completion_tokens\":175,\"total_tokens\":4411,\"prompt_tokens_details\":{\"cached_tokens\":0},\"completion_tokens_details\":{\"reasoning_tokens\":0}}}\n+\n+data: [DONE]\n+\n",
