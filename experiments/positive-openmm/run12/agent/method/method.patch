+def main():
+    parser = argparse.ArgumentParser()
+    parser.add_argument('--replicas', type=int, default=8)
+    parser.add_argument('--steps', type=int, default=25000)
+    parser.add_argument('--seed0', type=int, default=1000)
+    parser.add_argument('--platform', default='CUDA')
+    parser.add_argument('--out', default='ensemble.json')
+    args = parser.parse_args()
+    assert args.replicas == 8 and args.steps == 25000
+    start = time.perf_counter()
+    # Spawn owns all mutable simulation/RNG state in each worker. Ordered futures
+    # preserve replica identity independently of completion order.
+    with concurrent.futures.ProcessPoolExecutor(
+            max_workers=4, mp_context=multiprocessing.get_context('spawn'),
+            initializer=initialize, initargs=(args.platform,)) as pool:
+        futures = [pool.submit(run_replica, i, args.seed0, args.steps) for i in range(args.replicas)]
+        replicas = [future.result() for future in futures]
+    # Every final energy query blocks on GPU completion, every Context is
+    # destroyed and every worker has exited before collecting ensemble time.
+    total = time.perf_counter() - start
+    simulated_ns = args.replicas * args.steps * 0.004 / 1000
+    properties = {'Precision': 'single', 'DeterministicForces': 'true'} if args.platform == 'CUDA' else {}
+    with open(args.out, 'w') as handle:
+        json.dump(dict(platform=args.platform, properties=properties, simulated_ns=simulated_ns,
+                       total_wall_s=total, replicas=replicas), handle, indent=1, allow_nan=False)
+    print(f'total_wall_s: {total:.3f}')
+    print(f'aggregate_ns_per_day: {simulated_ns / total * 86400:.1f}')
+
+
+if __name__ == '__main__':
+    main()
