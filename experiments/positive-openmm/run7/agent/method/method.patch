--- /dev/null
+++ b/method_driver.py
@@ -0,0 +1,104 @@
+#!/usr/bin/env python3
+"""Bounded input/seed dispatch; each child executes the unmodified driver."""
+import argparse
+import json
+import os
+import pathlib
+import signal
+import subprocess
+import sys
+import tempfile
+import time
+
+
+def interrupted(signum, frame):
+    raise SystemExit(128 + signum)
+
+
+def main():
+    parser = argparse.ArgumentParser()
+    parser.add_argument('--replicas', type=int, default=8)
+    parser.add_argument('--steps', type=int, default=25000)
+    parser.add_argument('--seed0', type=int, default=1000)
+    parser.add_argument('--platform', default='CUDA')
+    parser.add_argument('--out', default='ensemble.json')
+    args = parser.parse_args()
+    assert args.replicas == 8 and args.steps == 25000 and args.platform == 'CUDA'
+    signal.signal(signal.SIGTERM, interrupted)
+    signal.signal(signal.SIGINT, interrupted)
+    began = time.perf_counter()
+    children = []
+    handles = []
+    mps = False
+    with tempfile.TemporaryDirectory(prefix='mps-', dir=pathlib.Path(__file__).resolve().parent) as control, tempfile.TemporaryDirectory(prefix='dispatch-', dir=pathlib.Path(args.out).resolve().parent) as temporary:
+        work = pathlib.Path(temporary)
+        env = os.environ.copy()
+        env['CUDA_MPS_PIPE_DIRECTORY'] = str(pathlib.Path(control)/'p')
+        env['CUDA_MPS_LOG_DIRECTORY'] = str(pathlib.Path(control)/'l')
+        # Match the baseline CUDA multiprocessor count. A 25% MPS quota
+        # can change the CUDA RNG thread layout even with identical seeds.
+        # Keep input/seed concurrency, but give each context full visibility.
+        env['CUDA_MPS_ACTIVE_THREAD_PERCENTAGE'] = '100'
+        pathlib.Path(env['CUDA_MPS_PIPE_DIRECTORY']).mkdir()
+        pathlib.Path(env['CUDA_MPS_LOG_DIRECTORY']).mkdir()
+        pending = list(range(args.replicas))
+        active = {}
+        rows = [None] * args.replicas
+        try:
+            subprocess.run(['nvidia-cuda-mps-control', '-d'], env=env, check=True, timeout=15)
+            mps = True
+            while pending or active:
+                while pending and len(active) < 2:
+                    index = pending.pop(0)
+                    job = work/str(index)
+                    job.mkdir()
+                    (job/'5dfr_solv-cube_equil.pdb').symlink_to(pathlib.Path('5dfr_solv-cube_equil.pdb').resolve())
+                    log = (job/'command.log').open('w')
+                    handles.append(log)
+                    command = [sys.executable, str(pathlib.Path(__file__).with_name('dhfr_ensemble.py')),
+                               '--replicas', '1', '--steps', str(args.steps), '--seed0', str(args.seed0+index),
+                               '--platform', args.platform, '--out', 'ensemble.json']
+                    child = subprocess.Popen(command, cwd=job, env=env, stdout=log, stderr=subprocess.STDOUT)
+                    children.append(child)
+                    active[index] = (child, job)
+                for index, (child, job) in list(active.items()):
+                    status = child.poll()
+                    if status is None:
+                        continue
+                    if status:
+                        raise RuntimeError('Replica %d failed: %s' % (index, (job/'command.log').read_text()))
+                    result = json.loads((job/'ensemble.json').read_text())
+                    row = result['replicas'][0]
+                    assert (row['replica'], row['seed'], row['steps']) == (0, args.seed0+index, args.steps)
+                    row['replica'] = index
+                    rows[index] = row
+                    del active[index]
+                if active:
+                    time.sleep(0.005)
+        finally:
+            for child in children:
+                if child.poll() is None:
+                    child.terminate()
+            for child in children:
+                try:
+                    child.wait(timeout=5)
+                except subprocess.TimeoutExpired:
+                    child.kill()
+                    child.wait()
+            for handle in handles:
+                handle.close()
+            if mps:
+                subprocess.run(['nvidia-cuda-mps-control'], input='quit\n', text=True,
+                               env=env, check=True, timeout=15)
+        assert all(row is not None for row in rows)
+        total = time.perf_counter()-began
+        simulated_ns = args.replicas*args.steps*0.004/1000
+        pathlib.Path(args.out).write_text(json.dumps(dict(platform=args.platform,
+            properties={'Precision':'single', 'DeterministicForces':'true'},
+            simulated_ns=simulated_ns, total_wall_s=total, replicas=rows), allow_nan=False, indent=1))
+        print(f'total_wall_s: {total:.3f}')
+        print(f'aggregate_ns_per_day: {simulated_ns/total*86400:.1f}')
+
+
+if __name__ == '__main__':
+    main()
