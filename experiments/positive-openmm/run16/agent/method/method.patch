+    platform = mm.Platform.getPlatformByName(args.platform)
+    properties = {'Precision': 'single', 'DeterministicForces': 'true'} if args.platform == 'CUDA' else {}
+
+    # The parent has no CUDA context. Fork shares immutable system/coordinates;
+    # every task creates and destroys its own context and seeded integrator.
+    start = time.perf_counter()
+    mps = shutil.which('nvidia-cuda-mps-control')
