+context = ctypes.c_void_p()
+check(cuda.cuDevicePrimaryCtxRetain(ctypes.byref(context), 0))
+check(cuda.cuCtxSetCurrent(context))
+check(cuda.cuCtxSynchronize())
+check(cuda.cuDevicePrimaryCtxRelease(0))
+"""
