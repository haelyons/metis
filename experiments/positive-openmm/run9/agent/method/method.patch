+
+if __name__ == '__main__':
+    synchronize_device()
+    start = time.perf_counter()
+    # Four persistent independent processes, two fixed waves. Each task creates
+    # a fresh integrator, seeded velocities and Context, exactly as before.
+    pool = multiprocessing.get_context('fork').Pool(processes=4)
+    try:
+        replicas = pool.map(run_replica, range(4), chunksize=1)
+        replicas += pool.map(run_replica, range(4, args.replicas), chunksize=1)
+        pool.close()
+        pool.join()
+    except BaseException:
+        pool.terminate()
+        pool.join()
