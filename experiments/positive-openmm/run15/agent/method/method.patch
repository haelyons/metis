+def main():
+    parser = argparse.ArgumentParser()
+    parser.add_argument('--replicas', type=int, default=8)
+    parser.add_argument('--steps', type=int, default=25000)
+    parser.add_argument('--seed0', type=int, default=1000)
+    parser.add_argument('--platform', default='CUDA')
+    parser.add_argument('--out', default='ensemble.json')
+    args = parser.parse_args()
+    assert args.replicas > 0 and args.steps > 0 and args.steps % 250 == 0
+    properties = {'Precision': 'single', 'DeterministicForces': 'true'} if args.platform == 'CUDA' else {}
+    start = time.perf_counter()
+    # The pipeline owns MPS. Inherit its socket and device settings, including
+    # the default MPS socket when no pipe-directory override is exported.
+    with concurrent.futures.ProcessPoolExecutor(
+            max_workers=min(4, args.replicas),
+            mp_context=multiprocessing.get_context('spawn')) as pool:
+        futures = [pool.submit(run_replica, i, args.seed0 + i, args.steps, args.platform)
+                   for i in range(args.replicas)]
+        replicas = [future.result() for future in futures]
+    # Final energy queries synchronize each context; joining the pool completes
+    # every worker's context destruction before timing stops or results return.
+    total = time.perf_counter() - start
+    simulated_ns = args.replicas * args.steps * 0.004 / 1000
+    Path(args.out).resolve().parent.mkdir(parents=True, exist_ok=True)
+    with open(args.out, 'w') as handle:
+        json.dump(dict(platform=args.platform, properties=properties, simulated_ns=simulated_ns,
+                       total_wall_s=total, replicas=replicas), handle, indent=1)
+    print(f'total_wall_s: {total:.3f}')
+    print(f'aggregate_ns_per_day: {simulated_ns / total * 86400:.1f}')
+
+
+if __name__ == '__main__':
+    main()
