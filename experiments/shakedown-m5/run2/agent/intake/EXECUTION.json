  "outputs": {
    "interface": "Sample stdout plus process exit status",
    "metrics": [
      {
        "name": "Total time (ms.)",
        "unit": "ms",
        "role": "Streamed timing score"
      },
      {
        "name": "Average reserve",
        "role": "Strict >1 correctness criterion"
      },
      {
        "name": "L1 norm",
        "role": "Diagnostic; no published threshold"
      },
      {
        "name": "Test passed / Test failed!",
        "role": "Final verdict; encode 1 / 0"
      }
    ],
    "retain": [
      "Raw stdout",
      "Process exit status",
      "Chosen source constants",
      "GPU model/count",
      "Grid size",
      "Toolkit",
      "libc"
    ],
    "anchors_file": "anchors.json",
    "scoring": "Require both anchor comparisons; use verdict or unrounded reserve at printed boundary. Report measured time for real selected workload; no toy extrapolation."
  },
  "timing_scope": {
    "mode": "streamed",
    "includes": [
      "Option preprocessing",
      "H2D input transfer",
      "GPU pricing",
      "D2H result transfer",
      "Completion event waits"
    ],
    "excludes": [
      "Compilation",
      "Allocation",
      "RNG initialization",
      "CPU result finalization",
      "Black-Scholes validation"
    ],
    "source": [
      "https://github.com/NVIDIA/cuda-samples/blob/db3eea23946bca2e90a75eca2b5b3e07158a9e11/Samples/5_Domain_Specific/MonteCarloMultiGPU/MonteCarloMultiGPU.cpp#L147-L194",
