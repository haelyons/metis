    ],
    "caveat": "Upstream warns samples are not intended for performance measurements; GPU Boost affects results."
  },
  "run_commands": [
    "CUDA_VISIBLE_DEVICES=0 ./build-mc/MonteCarloMultiGPU --method=streamed --scaling=strong"
  ],
  "timeout_s": 3600
