\\\"description\\\":\\\"Dollars. An expression: numbers, ids of numbers, rates and lines, budget_usd, fs_usd_gib_month (the price sheet's filesystem price per GiB-month), + - * / ^ ( ), ceil floor min max pow.\\\"},\\\"ratio_to\\\":{\\\"type\\\":\\\"string\\\",\\\"description\\\":\\\"A number id to compare this run with.\\\"}},\\\"required\\\":[\\\"id\\\",\\\"what\\\",\\\"usd\\\"]},\\\"description\\\":\\\"Runs the budget cannot buy.\\\"},\\\"outside_budget\\\":{\\\"type\\\":\\\"array\\\",\\\"items\\\":{\\\"type\\\":\\\"object\\\",\\\"properties\\\":{\\\"what\\\":{\\\"type\\\":\\\"string\\\"},\\\"qty\\\":{\\\"type\\\":\\\"number\\\"},\\\"unit\\\":{\\\"type\\\":\\\"string\\\"}},\\\"required\\\":[\\\"what\\\",\\\"qty\\\",\\\"unit\\\"]},\\\"description\\\":\\\"Resources used that the budget does not pay for.\\\"},\\\"restructuring\\\":{\\\"type\\\":\\\"object\\\",\\\"properties\\\":{\\\"sequential_part\\\":{\\\"type\\\":\\\"string\\\",\\\"description\\\":\\\"What one answer waits on step after step, and how many steps. Card field: plain words for a reader who has not seen your files, at most 18 words, no labels from your files; may cite a source as [source id].\\\"},\\\"method\\\":{\\\"type\\\":\\\"string\\\",\\\"description\\\":\\\"Why those steps need not run in order and how the plan computes them at the same time; or \\\\\"none\\\\\". Card field: plain words for a reader who has not seen your files, at most 22 words, no labels from your files; may cite a source as [source id].\\\"},\\\"condition\\\":{\\\"type\\\":\\\"string\\\",\\\"description\\\":\\\"What must hold about this system for the method to pay off, and the cheap measurement that checks it.\\\"},\\\"condition_phase\\\":{\\\"type\\\":\\\"string\\\",\\\"description\\\":\\\"The id of the phase that makes that measurement before the main spend.\\\"},\\\"baseline_sequential\\\":{\\\"type\\\":\\\"string\\\",\\\"description\\\":\\\"The fastest sequential implementation the plan times, and how it is tuned.\\\"},\\\"baseline_copies\\\":{\\\"type\\\":\\\"string\\\",\\\"description\\\":\\\"Independent copies run side by side on the same GPUs, which the plan also times.\\\"}},\\\"required\\\":[\\\"sequential_part\\\",\\\"method\\\"]},\\\"scope_gap\\\":{\\\"type\\\":\\\"array\\\",\\\"items\\\":{\\\"type\\\":\\\"string\\\"},\\\"description\\\":\\\"What the budget cannot test about the option's claim.\\\"},\\\"novelty\\\":{\\\"type\\\":\\\"object\\\",\\\"properties\\\":{\\\"closest_prior\\\":{\\\"type\\\":\\\"string\\\",\\\"description\\\":\\\"The published result that comes nearest to deciding between if_lever and if_not: what it measured and the largest amount of the compute quantity it used. Card field: plain words for a reader who has not seen your files, at most 30 words, no labels from your files; may cite a source as [source id].\\\"},\\\"closest_source_id\\\":{\\\"type\\\":\\\"string\\\"},\\\"prior_max_level\\\":{\\\"type\\\":[\\\"number\\\",\\\"null\\\"],\\\"description\\\":\\\"That largest amount in compute_axis.unit, or null if it is not on the same axis.\\\"},\\\"left_open\\\":{\\\"type\\\":\\\"string\\\",\\\"description\\\":\\\"Card field: plain words for a reader who has not seen your files, at most 30 words, no labels from your files; may cite a source as [source id].\\\"},\\\"decides\\\":{\\\"type\\\":\\\"string\\\",\\\"enum\\\":[\\\"no\\\",\\\"partly\\\",\\\"yes\\\"],\\\"description\\\":\\\"Does closest_prior already decide the outcome at your compute levels?\\\"},\\\"searched\\\":{\\\"type\\\":\\\"boolean\\\",\\\"description\\\":\\\"Did web search return results while you planned?\\\"}},\\\"required\\\":[\\\"closest_prior\\\",\\\"left_open\\\",\\\"decides\\\",\\\"searched\\\"]},\\\"limits\\\":{\\\"type\\\":\\\"array\\\",\\\"items\\\":{\\\"type\\\":\\\"string\\\"},\\\"description\\\":\\\"What the result would not show. Card field: plain words, at most 30 words in all, no labels from your files.\\\"},\\\"test_summary\\\":{\\\"type\\\":\\\"string\\\",\\\"description