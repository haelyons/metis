# Equilibration: minimize -> relax -> NPT -> deform to mean density -> equilibrated.restart.

variable        system_dir            index .
variable        T                     index 298.15
variable        P                     index 1.0
variable        run_id                index 1
variable        timestep_fs           index 1.0
variable        thermo_every          index 5000
variable        tdamp                 index 100.0
variable        pdamp                 index 1000.0
variable        relax_dt              index 0.5
variable        pushoff_steps         index 50000
variable        settle_steps          index 100000
variable        npt_steps             index 1000000
variable        deform_steps          index 500000
variable        density_avg_start     index 750000
variable        density_sample_every  index 100
variable        density_sample_repeat index 2500
variable        density_sample_freq   index 250000
variable        shake_tol             index 0.0001
variable        shake_iter            index 20
variable        shake_order           index 0
variable        seed                  equal 4928459+${run_id}*10007

log             ${system_dir}/log_equilibrate_T${T}K_run${run_id}.out

include         ${system_dir}/in.init
read_data       ${system_dir}/in.data
include         ${system_dir}/in.settings
timestep        ${timestep_fs}

thermo          ${thermo_every}
thermo_style    custom step temp press density vol lx ly lz pe etotal

# rebalance MPI domains (dilute packing)
comm_style      tiled
balance         1.1 rcb

min_style       cg
minimize        1.0e-4 1.0e-6 1000 10000

velocity        all create ${T} ${seed} mom yes rot yes dist gaussian
fix             constrain_h all shake ${shake_tol} ${shake_iter} ${shake_order} m 1.008
# SHAKE before box-changing fixes
fix             load_balance all balance 2000 1.05 rcb

# stage 0: Langevin capped-displacement strain relaxation (reduced dt)
neigh_modify    one 10000 page 200000

timestep        ${relax_dt}
fix             relax_int  all nve/limit 0.1
fix             relax_lang all langevin ${T} ${T} ${tdamp} ${seed}
run             ${pushoff_steps}
unfix           relax_int
unfix           relax_lang

# stage 1: NVT settle
timestep        ${timestep_fs}
fix             nvt_settle all nvt temp ${T} ${T} ${tdamp}
run             ${settle_steps}
unfix           nvt_settle

reset_timestep  0
variable        rho equal density
fix             npt_density all ave/time ${density_sample_every} ${density_sample_repeat} ${density_sample_freq} v_rho &
                file ${system_dir}/density_npt_T${T}K_run${run_id}.dat ave one start ${density_avg_start}
fix             eq_npt all npt temp ${T} ${T} ${tdamp} iso ${P} ${P} ${pdamp} nreset 1000
# Edit listed in the design (run cp1): write the unwrapped centre of every molecule every 1 ps.
variable        com_every             index 500
compute         cp1_mol all chunk/atom molecule
compute         cp1_com all com/chunk cp1_mol
fix             cp1_com_out all ave/time ${com_every} 1 ${com_every} c_cp1_com[*] file ${system_dir}/com_npt_T${T}K_run${run_id}.dat mode vector
run             ${npt_steps}
unfix           eq_npt

variable        rho_target equal $(f_npt_density:%.12g)
print           "NPT average density target from final window: ${rho_target} g/cm^3"
unfix           npt_density

unfix           constrain_h

write_restart   ${system_dir}/equilibrated_T${T}K.restart
write_data      ${system_dir}/equilibrated_T${T}K.data nocoeff
print           "Equilibration done: wrote ${system_dir}/equilibrated_T${T}K.restart, target_density=${rho_target} g/cm^3, final_density=$(density:%.6f) g/cm^3"
